    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

  <!-- Vertical bar -->
  <path android:fillColor="#FFFFFF"
        android:pathData="M4,2 L7,2 L7,22 L4,22 Z"/>

  <!-- Upper diagonal arm: (7,6)→(7,12)→(20,5)→(20,2) -->
  <path android:fillColor="#FFFFFF"
        android:pathData="M7,6 L7,12 L20,5 L20,2 Z"/>

  <!-- Lower diagonal arm: (7,12)→(7,18)→(20,22)→(20,19) -->
  <path android:fillColor="#FFFFFF"
        android:pathData="M7,12 L7,18 L20,22 L20,19 Z"/>

</vector>
