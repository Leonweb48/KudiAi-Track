# KudiTrack AI — Environment Variables
# Copy this file to .env and fill in your values

# ── Supabase (required) ───────────────────────────────────────────────────────
# Get these from: Supabase dashboard → Project Settings → API
REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-public-key

# ── Anthropic API (required for AI Insights screen) ──────────────────────────
# Get your key from: https://console.anthropic.com/
REACT_APP_ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Paystack (required for paid subscriptions) ────────────────────────────────
# Get your key from: https://dashboard.paystack.com/#/settings/developer
REACT_APP_PAYSTACK_PUBLIC_KEY=pk_live_your-paystack-key

# ── App config ────────────────────────────────────────────────────────────────
# REACT_APP_APP_NAME=KudiTrack AI
# REACT_APP_SUPPORT_WHATSAPP=+2348012345678
# REACT_APP_SUPPORT_EMAIL=support@kuditrack.ng
